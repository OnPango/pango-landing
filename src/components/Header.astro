---
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "#";
const links = [
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#beneficios", label: "Beneficios" },
  { href: "#para-quien", label: "Para quién" },
  { href: "#preguntas", label: "Preguntas" },
];
---

<header class="top-0 z-70 mb-5">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 pt-5">
    <a
      href="#top"
      class="flex items-center font-display text-2xl md:text-3xl font-bold tracking-wide gap-2"
    >
      <img
        src="/logos/pango-marca-tinta.svg"
        alt="Pango"
        width="32"
        height="32"
        class="size-8 dark:hidden"
      />
      <img
        src="/logos/pango-marca-marron.svg"
        alt="Pango"
        width="32"
        height="32"
        class="hidden size-8 dark:block"
      />
      PANGO
    </a>
    <nav
      aria-label="Principal"
      class="hidden lg:flex justify-around items-center max-w-5xl bg-card border border-line rounded-full px-2 py-2 shadow-[0_0px_45px_0_rgba(0,0,0,0.05)] gap-5 text-md text-soft"
    >
      {links.map((l) => (
        <a
          href={l.href}
          class="text-fg hover:bg-black/20 py-2 px-4 rounded-full"
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line text-soft hover:text-fg"
        aria-label="Cambiar tema"
      >
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <a
        href={appUrl}
        class="rounded-full bg-copper px-2 py-2 md:px-5 md:py-3 text-md font-medium text-[#f6f1e7] hover:opacity-90"
      >
        Ingresar
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("pango-theme", next);
    } catch {}
  });
</script>
