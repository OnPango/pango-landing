---
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "#";
const links = [
	{ href: "#como-funciona", label: "Cómo funciona" },
  	{ href: "#beneficios", label: "Beneficios" },
  	{ href: "#para-quien", label: "Para quién" },
  	{ href: "#preguntas", label: "Preguntas" },
];
---

<header>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 pt-5">
    <a href="#top" class="flex items-center font-display text-3xl font-bold tracking-wide gap-2">
		<svg width="36" height="36" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M38.9001 19.8C40.1797 23.2694 40.3598 27.0487 39.4158 30.624C38.4718 34.1993 36.4496 37.3971 33.6241 39.7826C30.7986 42.1681 27.307 43.6255 23.624 43.9566C19.941 44.2877 16.2454 43.4765 13.0397 41.6332C9.83406 39.79 7.27387 37.0041 5.70731 33.6545C4.14074 30.3049 3.64382 26.5541 4.28412 22.9121C4.92442 19.2701 6.67087 15.9137 9.28598 13.2993C11.9011 10.6849 15.258 8.93934 18.9001 8.3" stroke-width="4.5" stroke-linecap="round" stroke="var(--color-copper)"/>
			<path d="M32.3001 22.2C33.0888 24.3196 33.2051 26.6309 32.633 28.8189C32.0608 31.007 30.8282 32.9655 29.1029 34.4278C27.3776 35.8901 25.2435 36.785 22.9912 36.9907C20.7389 37.1964 18.478 36.7029 16.5164 35.5773C14.5547 34.4518 12.9877 32.749 12.0286 30.7007C11.0696 28.6525 10.7653 26.3584 11.157 24.131C11.5487 21.9036 12.6175 19.851 14.2178 18.2529C15.8181 16.6547 17.8721 15.5887 20.1001 15.2" stroke-width="4" stroke-linecap="round" stroke="var(--color-fg)"/>
			<path d="M21.9998 29.2C23.7671 29.2 25.1998 27.7673 25.1998 26C25.1998 24.2327 23.7671 22.8 21.9998 22.8C20.2325 22.8 18.7998 24.2327 18.7998 26C18.7998 27.7673 20.2325 29.2 21.9998 29.2Z" fill="var(--color-copper)"/>
			<path d="M37.9998 12.2C40.3194 12.2 42.1998 10.3196 42.1998 8C42.1998 5.6804 40.3194 3.8 37.9998 3.8C35.6802 3.8 33.7998 5.6804 33.7998 8C33.7998 10.3196 35.6802 12.2 37.9998 12.2Z" fill="var(--color-fg)"/>
			<path d="M6.0002 43.8C6.99431 43.8 7.8002 42.9941 7.8002 42C7.8002 41.0059 6.99431 40.2 6.0002 40.2C5.00608 40.2 4.2002 41.0059 4.2002 42C4.2002 42.9941 5.00608 43.8 6.0002 43.8Z" fill="var(--color-fg)"/>
		</svg>

		PANGO
	</a>
    <nav aria-label="Principal" class="hidden md:flex justify-around items-center max-w-5xl bg-sunk border border-line rounded-full px-2 py-2 shadow-[0_0px_45px_0_rgba(0,0,0,0.05)] gap-5 text-md text-soft">
      {links.map((l) => <a href={l.href} class="text-fg hover:bg-black/20 py-2 px-4 rounded-full">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line text-soft hover:text-fg"
        aria-label="Cambiar tema"
      >
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
	  <a href={appUrl} class="rounded-full bg-sunk px-5 py-3 text-md font-medium text-fg hover:opacity-90">Ingresar</a>
      <a href={appUrl} class="rounded-full bg-copper px-5 py-3 text-md font-medium text-[#f6f1e7] hover:opacity-90">Empezar</a>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("pango-theme", next); } catch {}
  });
</script>
