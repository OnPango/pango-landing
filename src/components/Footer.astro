---
import { appLinks } from "../app-links";

const appUrl = appLinks.login;
---

<footer class="bg-bg border border-line">
  <div class="wrap flex flex-wrap items-center justify-between gap-6 py-8 text-fg">
    <div class="flex flex-col gap-2.5">
      <a
        href="#top"
        class="flex items-center font-display text-2xl md:text-3xl font-bold tracking-wide gap-2"
      >
        <img
          src="/logos/pango-marca-tinta.svg"
          alt="Pango"
          width="32"
          height="32"
          class="size-8 dark:hidden"
        />
        <img
          src="/logos/pango-marca-marron.svg"
          alt="Pango"
          width="32"
          height="32"
          class="hidden size-8 dark:block"
        />
        PANGO
      </a>
      <span class="text-sm">Protege y anticipa tu inventario.</span>
    </div>
    <nav
      aria-label="Pie de página"
      class="flex flex-wrap text-soft gap-x-5 gap-y-1.5"
    >
      <a href="#como">Cómo funciona</a>
      <a href="#beneficios">Beneficios</a>
      <a href="#preguntas">Preguntas</a>
      <a href={appUrl}>Iniciar sesión</a>
      <a href="#">Privacidad</a>
      <a href="#">Términos</a>
    </nav>
    <span class="text-[13px]">© {new Date().getFullYear()} Pango</span>
  </div>
</footer>
