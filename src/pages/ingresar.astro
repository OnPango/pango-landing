---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Entra a tu espacio | PANGO" description="Encuentra el espacio de trabajo de tu empresa en PANGO.">
  <main class="min-h-screen bg-bg text-fg">
    <header class="wrap py-7">
      <a href="/" class="inline-flex items-center gap-3 font-display text-2xl font-bold text-fg">
        <img src="/favicon.svg" alt="" class="h-9 w-9" />
        PANGO
      </a>
    </header>
    <section class="mx-auto flex min-h-[75vh] max-w-lg items-center px-5 py-12">
      <div class="w-full rounded-[28px] border border-line bg-card p-7 shadow-xl sm:p-10">
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-bg text-copper" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="8" width="16" height="13" rx="2"/><path d="M9 8V4h6v4M9 12h2m2 0h2m-6 4h2m2 0h2"/></svg>
        </div>
        <h1 class="font-display text-3xl font-bold">Entra a tu espacio</h1>
        <p class="mt-2 text-soft">Escribe la dirección de tu empresa en Pango.</p>
        <form id="workspace-form" class="mt-7">
          <label for="workspace" class="mb-2 block text-sm font-semibold">Dirección de tu empresa</label>
          <div class="flex overflow-hidden rounded-xl border border-line bg-bg focus-within:ring-2 focus-within:ring-copper">
            <input id="workspace" name="workspace" type="text" placeholder="tuempresa" autocomplete="organization" autocapitalize="off" spellcheck="false" maxlength="41" required class="min-w-0 flex-1 bg-transparent px-4 py-3 text-fg outline-none" aria-describedby="workspace-help workspace-error"/>
            <span class="flex shrink-0 items-center border-l border-line px-3 text-sm text-soft">.onpango.com</span>
          </div>
          <p id="workspace-help" class="mt-2 text-xs text-soft">Es la dirección que registraste al crear tu cuenta.</p>
          <p id="workspace-error" role="alert" aria-live="polite" class="mt-3 hidden text-sm text-red-600"></p>
          <button id="workspace-submit" type="submit" class="mt-6 w-full rounded-xl bg-copper px-5 py-3 font-semibold text-white hover:opacity-90 disabled:opacity-60">Continuar →</button>
        </form>
        <p class="mt-6 text-center text-sm text-soft">¿Tu empresa aún no está en Pango? <a class="font-semibold text-copper underline" href="https://app.onpango.com/register">Crear una cuenta</a></p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#workspace-form");
  const input = document.querySelector<HTMLInputElement>("#workspace");
  const error = document.querySelector<HTMLElement>("#workspace-error");
  const button = document.querySelector<HTMLButtonElement>("#workspace-submit");
  const reserved = new Set(["admin","api","app","assets","auth","cdn","dashboard","docs","help","login","mail","pango","onpango","signup","static","status","support","www"]);
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !error || !button) return;
    const slug = input.value.trim().toLowerCase();
    error.classList.add("hidden");
    input.setAttribute("aria-invalid", "false");
    if (!/^[a-z0-9](?:[a-z0-9-]{0,39}[a-z0-9])$/.test(slug) || reserved.has(slug)) {
      error.textContent = "Escribe una dirección válida de empresa (2 a 41 caracteres, letras, números o guiones).";
      error.classList.remove("hidden");
      input.setAttribute("aria-invalid", "true");
      return;
    }
    button.disabled = true;
    button.textContent = "Buscando empresa…";
    try {
      const response = await fetch("https://api.onpango.com/organizations/current", {
        headers: { "X-Tenant": slug },
      });
      if (response.status === 404) {
        error.textContent = "No encontramos una empresa con esa dirección.";
        error.classList.remove("hidden");
        input.setAttribute("aria-invalid", "true");
        return;
      }
      if (!response.ok) throw new Error("Error al consultar la empresa");
      const organization = await response.json();
      if (organization.subdomain !== slug) throw new Error("La dirección no coincide");
      window.location.assign(`https://${slug}.onpango.com/login`);
    } catch {
      error.textContent = "No pudimos verificar la empresa. Inténtalo de nuevo.";
      error.classList.remove("hidden");
    } finally {
      button.disabled = false;
      button.textContent = "Continuar →";
    }
  });
</script>
